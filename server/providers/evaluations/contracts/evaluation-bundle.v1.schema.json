{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gchust/nb3-factory/.github/contracts/evaluation-bundle.v1.schema.json",
  "title": "NB3 Factory evaluation bundle manifest v1",
  "description": "manifest.json inside evaluation-bundle.zip. It lists every other file with its purpose, size and SHA-256 and never lists itself. The ZIP's own SHA-256 is sent in X-Evaluation-Bundle-SHA256 and kept in delivery receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "subject", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "evaluation-bundle" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "revision", "sourceInstance"],
      "properties": {
        "type": { "enum": ["evaluation-report", "evaluation-batch"] },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,299}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "sourceInstance": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2047,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "mediaType", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?:evaluation\\.json|report\\.html|evidence/[A-Za-z0-9][A-Za-z0-9._/-]{0,250}\\.png)$" },
          "role": { "enum": ["evaluation-report", "evaluation-batch", "report-html", "evidence"] },
          "mediaType": { "enum": ["application/json", "text/html", "image/png"] },
          "size": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "evidenceIds": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "maxLength": 251 } }
        }
      }
    }
  }
}
