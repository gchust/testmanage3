+/**
+ * Reads the application's own `allowBuilds` decisions.
+ *
+ * A generated application decides which packages may run install scripts in its `pnpm-workspace.yaml`; the
+ * deployment tree has to make the same decision, or a package the application deliberately skips (because it
+ * ships usable prebuilt binaries) is compiled during `pnpm build` and fails wherever no C++ toolchain exists.
+ * Falls back to the template defaults when the application has no such file or block.
+ */
+const readAllowBuilds = () => {
+  const fallback = [
+    '  better-sqlite3: true',
+    '  oracledb: true',
+    '  esbuild: true',
+    '  tesseract.js: false',
+  ];
+  let source;
+  try {
+    source = fs.readFileSync(path.join(rootDir, 'pnpm-workspace.yaml'), 'utf8');
+  } catch {
+    return fallback;
+  }
+
+  const lines = source.split(/\r?\n/u);
+  const start = lines.findIndex((line) => /^allowBuilds:\s*$/u.test(line));
+  if (start === -1) return fallback;
+
+  const entries = [];
+  for (const line of lines.slice(start + 1)) {
+    if (/^\s*(?:#|$)/u.test(line)) continue;
+    const match = /^\s+([@a-z0-9._/-]+):\s*(true|false)\s*$/iu.exec(line);
+    if (!match) break;
+    entries.push(`  ${match[1]}: ${match[2]}`);
+  }
+
+  return entries.length > 0 ? entries : fallback;
+};
